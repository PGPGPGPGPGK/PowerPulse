# PowerPulse web configuration.
# Copy to .env.local and fill in from:
#   Firebase console > Project settings > General > Your apps > Web app > SDK setup
# .env / .env.local are git-ignored. Never put a service-account key here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Set to "mock" to force the demo data source even when the
# Firebase values above are present. Leave unset to use Firestore.
VITE_DATA_SOURCE=

# Optional. MapLibre style URL. Defaults to OpenFreeMap's keyless
# OpenStreetMap vector tiles (https://openfreemap.org).
VITE_MAP_STYLE_URL=
